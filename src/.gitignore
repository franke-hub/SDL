##############################################################################
## ~/src/.gitignore
##############################################################################
## Links to ../usr/src/* and ../usr/src aren't distributed
/chrome
/lsl
/vbs

## Global file ignores (python compilation object in source directory)
**/__pycache__/
**/*.pyc

## Global file ignores (Should not occur)
**/debug.log
**/debug.out
**/*.stackdump

## Global extension ignores (Should not occur)
**/*.a
**/*.dll
**/*.exe
**/*.lib
**/*.o
**/*.obj
