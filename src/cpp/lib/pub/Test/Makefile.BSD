##############################################################################
##
## Title-
##       ~/src/cpp/lib/pub/Test/Makefile.BSD
##
## Purpose-
##       CYGWIN/LINUX Makefile customization.
##
## Last change date-
##       2025/02/26
##
##############################################################################

##############################################################################
## Local library
LIBOBJ := ############################
LIBOBJ += Empty.o
MAKEXE := $(patsubst $(OBJDIR)/Empty,,$(MAKEXE))

LLIBS  += -L. -llocal

##############################################################################
## Set default "make do" and "make it" target and options
ifeq "" "$(MAKEIT)"
MAKEIT := TestTime ################### The "make do" and "make it" target
endif
ifeq "" "$(MAKOPT)"
MAKOPT := --all ###################### The "make do" options
endif

##############################################################################
## Set default target
ifeq "" "$(DEFAULT)"
DEFAULT:= make.dir
endif

.PHONY: default
default: configure $(DEFAULT)

.PHONY: make.dir
make.dir: $(MAKEXE)
## make.dir: Enviro

.PHONY: make.all
make.all: configure $(MAKEXE)

all: make.all

##############################################################################
## TARGET: liblocal.a
liblocal.a: $(LIBOBJ)
	$(AR) $@ $^
	touch $@

##############################################################################
## TARGET: configure
.PHONY: configure
configure: ;
	@../../../../../bat/sys/configure.sh src/cpp/lib/pub

##############################################################################
## Run the Dirty program
.PHONY: dirty
dirty: Dirty
	@Dirty

##############################################################################
## Compile or run the default program
.PHONY: do, it
it: $(MAKEIT)
do: $(MAKEIT)
	$^ $(MAKOPT)

##############################################################################
## Run the Quick program
.PHONY: quick
quick: Quick
	@Quick --all --verbose

##############################################################################
## Make a certificate
host:=$(shell "hostname")
cert.dir: ;
	@printf "US\nState\nLocality\nCompany\nDivision\n$(host)\n\n\n" | \
openssl req -x509 -nodes -days 3653 -newkey rsa:2048 -keyout private.pem -out public.pem >/dev/null 2>/dev/null
	@printf "Generated private.pem, public.pem, valid for 10 years.\n"
	@touch cert.dir

.PHONY: cert keys
cert: cert.dir
keys: cert.dir                      ## Alias for cert

##############################################################################
## Verify the certificates
.PHONY: verify
verify: cert.dir
	openssl rsa -in private.pem -check -noout
	openssl x509 -in public.pem -text -noout

##############################################################################
## Dependency controls
include $(INCDIR)/pub/Makefile.BSD  ## PUB library controls
include $(INCDIR)/com/Makefile.BSD  ## Test_num.cpp requires Random

$(MAKEXE): $(LIBDIR)/libpub.a       ## All execs depend on PUB library
$(MAKEXE): liblocal.a               ## All execs depend on local library
TestSock: cert.dir                  ## TestSock depends on certificates

##############################################################################
## Makefile cleanup
.PHONY: clean.dir pristine.dir
pristine: pristine.dir
pristine.dir: ;
	@rm -f .have-version
	@rm -f cert.dir
	@rm -f private.pem
	@rm -f public.pem

clean: clean.dir
clean.dir: ;
	@rm -f liblocal.a
	@rm -f test_bug.*
	@rm -f test_time.*
	@rm -f trace.mem
