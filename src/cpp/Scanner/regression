## Recompile (if required)
if [[ "$1" == "--make" ]] ; then
  make Scanner
  rc=$?
  [[ $rc != 0 ]] && exit $rc
  shift
fi

## Run the scan
set -x
Scanner .home --verbose --all $@ 2>&1
