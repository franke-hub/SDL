##############################################################################

##############################################################################
## Set default paths
BINDIR = ../../../bin################# Binary directory


##############################################################################
## Set default target
ifeq "" "$(DEFAULT)"
DEFAULT:= $(MAKEXE)
endif

.PHONY: default
default: $(DEFAULT)

##############################################################################
## Add library controls and dependencies
include $(INCDIR)/com/Makefile.BSD
include $(INCDIR)/pub/Makefile.BSD

##############################################################################
## Target: install
.PHONY: install install-scanner

install: install-scanner
install-scanner: $(BINDIR)/scanner

$(BINDIR)/scanner: Scanner
	strip $<
	cp -fp $< $@

##############################################################################
## Cleanup
.PHONY: MAK_clean
clean:  MAK_clean
MAK_clean: ;
	@rm -f debug.*
