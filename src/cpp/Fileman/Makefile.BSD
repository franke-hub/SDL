##############################################################################

##############################################################################
## Set default paths
BINDIR = ../../../bin################# Binary directory

##############################################################################
## Set default target
ifeq "" "$(DEFAULT)"
DEFAULT:= $(MAKEXE)
endif

.PHONY: default
default: $(DEFAULT)

##############################################################################
## Add library controls and dependencies
include $(INCDIR)/com/Makefile.BSD
include $(INCDIR)/pub/Makefile.BSD

##############################################################################
## Target: install
.PHONY: install install-fileman install-filedate

install: install-fileman install-filedate
install-fileman: $(BINDIR)/fileman
install-filedate: $(BINDIR)/fileman.date

$(BINDIR)/fileman: Fileman
	strip $<
	cp -fp $< $@

$(BINDIR)/fileman.date: $(SRCDIR)/fileman.date
	cp -fp $< $@

##############################################################################
## Cleanup
.PHONY: MAK_clean
clean:  MAK_clean
MAK_clean: ;
	@rm -f debug.*
