##
## Title-
##       ~/bat/sys/.want-version
##
## Purpose-
##       Required recompile control file.
##
## Last change date-
##       2026/01/22
##
## Format-
##       version-name = version-identifier
##
## Usage notes-
##       Version control is used to force recompilation outside of normal
##       dependency controls.
##
##       See ~/bat/sys/configure.sh for more information.
##
##############################################################################

## CPP libraries
src/cpp/lib/com = 2026/01/01-00:00
src/cpp/lib/dev = 2026/01/01-00:00
src/cpp/lib/gui = 2026/01/01-00:00
src/cpp/lib/obj = 2026/01/01-00:00
src/cpp/lib/pub = 2026/01/01-00:00

## Python site-packages
src/py/site-packages/lib =   2026/01/01-00:00
src/py/site-packages/stdio = 2026/01/01-00:00
